function Particle({ index }: { index: number }) {
  const angle = (index / 16) * Math.PI * 2;
  const radius = 34 + (index % 4) * 7;

  return (
    <motion.span
      animate={{
        x: [
          `${Math.cos(angle) * radius}%`,
          `${Math.cos(angle + 0.5) * radius}%`,
          `${Math.cos(angle) * radius}%`,
        ],
        y: [
          `${Math.sin(angle) * radius}%`,
          `${Math.sin(angle + 0.5) * radius}%`,
          `${Math.sin(angle) * radius}%`,
        ],
        opacity: [0.2, 0.9, 0.2],
      }}
      transition={{
        duration: 5 + (index % 5),
        repeat: Infinity,
        ease: "easeInOut",
        delay: index * 0.15,
      }}
      className="
        absolute
        left-1/2
        top-1/2
        h-1.5
        w-1.5
        rounded-full
        bg-cyan-400
        shadow-[0_0_15px_rgba(34,211,238,.9)]
      "
    />
  );
}

