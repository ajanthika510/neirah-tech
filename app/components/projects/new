/* =========================================================
   HELPERS
========================================================= */

function normalizeProject(item: RawProject, index: number): Project {
  const images =
    Array.isArray(item.images)
      ? item.images
          .map((image: any) =>
            typeof image === "string"
              ? image
              : image?.url || image?.src || image?.image
          )
          .filter(Boolean)
      : [];

  const image =
    item.image ||
    item.imageUrl ||
    item.thumbnail ||
    item.coverImage ||
    item.cover ||
    images[0];

  const technologies =
    Array.isArray(item.technologies)
      ? item.technologies.map((tech: any) =>
          typeof tech === "string"
            ? tech
            : tech?.name || tech?.title
        )
      : Array.isArray(item.techStack)
      ? item.techStack.map((tech: any) =>
          typeof tech === "string"
            ? tech
            : tech?.name || tech?.title
        )
      : [];

  return {
    id: String(item.id ?? item._id ?? index),
    title:
      item.title ||
      item.name ||
      `Project ${String(index + 1).padStart(2, "0")}`,
    slug:
      item.slug ||
      String(item.title || item.name || index)
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-"),
    description:
      item.description ||
      item.shortDescription ||
      "A digital experience engineered around a real business problem.",
    category:
      item.category?.name ||
      item.category ||
      item.type ||
      "Digital Experience",
    image,
    images: image
      ? Array.from(new Set([image, ...images]))
      : images,
    technologies,
    client: item.client || item.clientName,
    year: item.year
      ? String(item.year)
      : item.createdAt
      ? new Date(item.createdAt).getFullYear().toString()
      : undefined,
    role: item.role || item.services,
    result: item.result || item.outcome,
    url: item.url || item.liveUrl || item.website,
    featured: Boolean(item.featured),
  };
}

/* =========================================================
   PAGE
========================================================= */

export default function ProjectsPage() {
  const [projects, setProjects] = useState<Project[]>([]);
  const [loading, setLoading] = useState(true);
  const [activeCategory, setActiveCategory] = useState("All");
  const [selectedProject, setSelectedProject] =
    useState<Project | null>(null);

  useEffect(() => {
    let cancelled = false;

    async function loadProjects() {
      try {
        const response = await fetch(PROJECT_ENDPOINT, {
          cache: "no-store",
        });

        if (!response.ok) {
          throw new Error("Unable to load projects");
        }

        const data = await response.json();

        const list = Array.isArray(data)
          ? data
          : data.projects ||
            data.data ||
            data.results ||
            [];

        if (!cancelled) {
          setProjects(
            list.map((item: RawProject, index: number) =>
              normalizeProject(item, index)
            )
          );
        }
      } catch {
        if (!cancelled) {
          setProjects(fallbackProjects);
        }
      } finally {
        if (!cancelled) {
          setLoading(false);
        }
      }
    }

    loadProjects();

    return () => {
      cancelled = true;
    };
  }, []);

  const categories = useMemo(() => {
    return [
      "All",
      ...Array.from(
        new Set(projects.map((project) => project.category))
      ),
    ];
  }, [projects]);

  const filteredProjects = useMemo(() => {
    if (activeCategory === "All") return projects;

    return projects.filter(
      (project) => project.category === activeCategory
    );
  }, [projects, activeCategory]);

  const featuredProjects = useMemo(() => {
    const featured = projects.filter(
      (project) => project.featured
    );

    return featured.length
      ? featured.slice(0, 4)
      : projects.slice(0, 4);
  }, [projects]);

  return (
    <main className="min-h-screen overflow-hidden bg-[#F7FAFC] text-[#08111F]">
      <Hero />

      <FeaturedUniverse
        projects={featuredProjects}
        loading={loading}
        onOpen={setSelectedProject}
      />

      <Archive
        projects={filteredProjects}
        categories={categories}
        activeCategory={activeCategory}
        setActiveCategory={setActiveCategory}
        loading={loading}
        onOpen={setSelectedProject}
      />

      <FinalCTA />

      <AnimatePresence>
        {selectedProject && (
          <ProjectPreview
            project={selectedProject}
            onClose={() => setSelectedProject(null)}
          />
        )}
      </AnimatePresence>
    </main>
  );
}

